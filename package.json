{
  "name": "@webship.co/workspace-drupal-modules",
  "version": "1.0.10",
  "description": "The Drupal modules workspace for Webship Workspace: the `modules/` folder (type code), its settings file, its 6 commands, its docs and its AI items (an agent, a skill, a command and a prompt, each in the folder of its kind), activated as a plugin.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-drupal-modules.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "docs",
    "features",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "drupal-modules",
    "label": "Drupal modules",
    "needs": [
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "workspace": {
      "key": "modules",
      "settingsTemplate": "config/workspace.modules.settings.yml",
      "files": [
        "commands/cmd-tool-backup-module.sh",
        "commands/cmd-tool-git-change-filemode-to-false.sh",
        "commands/cmd-tool-git-clone-all-modules.sh",
        "commands/cmd-tools-checks.sh",
        "commands/cmd-tools-gitlab-ci-local.sh",
        "commands/cmd-tools-reclaim.sh"
      ],
      "docs": [
        "docs/AGENTS.md",
        "docs/CLAUDE.md",
        "docs/README.md"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/modules-maintainer.md"
      ],
      "skills": [
        "ai/skills/modules-workflow"
      ],
      "commands": [
        "ai/commands/modules-check.md"
      ],
      "prompts": [
        "ai/prompts/modules-green-gate.md"
      ]
    },
    "features": [
      "features/drupal-modules.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
